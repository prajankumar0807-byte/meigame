generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { SUPER_ADMIN STAFF USER PARTICIPANT }
enum Permission { CREATE_QUIZ EDIT_QUIZ DELETE_QUIZ START_QUIZ END_QUIZ VIEW_RESULTS VIEW_ANALYTICS }
enum QuizStatus { DRAFT PUBLISHED LIVE ENDED ARCHIVED }
enum Difficulty { EASY MEDIUM HARD }
enum QuestionType { MULTIPLE_CHOICE TRUE_FALSE }

enum ResultVisibility { AFTER_COMPLETION HIDDEN }

model User {
  id              String           @id @default(cuid())
  fullName        String
  username        String           @unique
  passwordHash    String
  collegeId       String?
  department      String?
  year            Int?
  section         String?
  email           String?
  phone           String?
  profilePhoto    String?
  role            Role             @default(USER)
  isActive        Boolean          @default(true)
  mustChangePassword Boolean        @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastLoginAt     DateTime?
  permissions     UserPermission[]
  quizzes         Quiz[]            @relation("CreatedQuizzes")
  activities      ActivityLog[]
}

model StaffPermission {
  id         String     @id @default(cuid())
  permission Permission @unique
  users      UserPermission[]
}

model UserPermission {
  userId       String
  permissionId String
  user         User @relation(fields:[userId], references:[id], onDelete: Cascade)
  permission   StaffPermission @relation(fields:[permissionId], references:[id], onDelete: Cascade)
  @@id([userId, permissionId])
}

model Quiz {
  id                 String            @id @default(cuid())
  title              String
  description        String?
  subject            String?
  department         String?
  year               Int?
  difficulty         Difficulty        @default(MEDIUM)
  status             QuizStatus        @default(DRAFT)
  joinCode            String            @unique
  startTime          DateTime?
  endTime            DateTime?
  timeLimit          Int?
  resultVisibility   ResultVisibility  @default(AFTER_COMPLETION)
  leaderboardEnabled Boolean           @default(true)
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          User              @relation("CreatedQuizzes", fields:[createdById], references:[id])
  questions          Question[]
  sessions           QuizSession[]
  participants       Participant[]
  results            QuizResult[]
  settings           QuizSetting?
}

model Question {
  id           String       @id @default(cuid())
  quizId       String
  questionText String
  questionType QuestionType @default(MULTIPLE_CHOICE)
  points       Int          @default(10)
  timeLimit    Int?
  explanation  String?
  order        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  quiz         Quiz         @relation(fields:[quizId], references:[id], onDelete: Cascade)
  options      QuestionOption[]
  answers      Answer[]
  @@index([quizId, order])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  optionText String
  isCorrect  Boolean  @default(false)
  order      Int
  question   Question @relation(fields:[questionId], references:[id], onDelete: Cascade)
  selectedAnswers Answer[]
  @@index([questionId, order])
}

model QuizSession {
  id            String      @id @default(cuid())
  quizId        String
  startedAt     DateTime?
  endedAt       DateTime?
  currentIndex  Int         @default(0)
  quiz          Quiz        @relation(fields:[quizId], references:[id], onDelete: Cascade)
  participants  Participant[]
}

model Participant {
  id          String      @id @default(cuid())
  quizId      String
  sessionId   String      @unique @default(cuid())
  quizSessionId String
  name        String
  collegeId   String?
  joinedAt    DateTime     @default(now())
  completedAt DateTime?
  quiz        Quiz         @relation(fields:[quizId], references:[id], onDelete: Cascade)
  session     QuizSession  @relation(fields:[quizSessionId], references:[id], onDelete: Cascade)
  answers     Answer[]
  result      QuizResult?
  @@index([quizId, joinedAt])
}

model Answer {
  id               String         @id @default(cuid())
  participantId    String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean
  pointsEarned     Int
  responseTime     Int?
  submittedAt      DateTime       @default(now())
  participant      Participant    @relation(fields:[participantId], references:[id], onDelete: Cascade)
  question         Question       @relation(fields:[questionId], references:[id], onDelete: Cascade)
  selectedOption   QuestionOption? @relation(fields:[selectedOptionId], references:[id])
  @@unique([participantId, questionId])
}

model QuizResult {
  id              String      @id @default(cuid())
  participantId   String      @unique
  quizId          String
  score           Int
  totalPoints     Int
  correctAnswers  Int
  incorrectAnswers Int
  accuracy        Float
  timeTaken       Int?
  rank            Int?
  createdAt       DateTime    @default(now())
  participant     Participant @relation(fields:[participantId], references:[id], onDelete: Cascade)
  quiz            Quiz        @relation(fields:[quizId], references:[id], onDelete: Cascade)
  @@index([quizId, score])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields:[userId], references:[id], onDelete: SetNull)
  @@index([createdAt])
  @@index([userId, createdAt])
}

model QuizSetting {
  id        String   @id @default(cuid())
  quizId    String   @unique
  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)
  showCorrectAnswers Boolean @default(false)
  quiz      Quiz @relation(fields:[quizId], references:[id], onDelete: Cascade)
}
